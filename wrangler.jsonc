{
  "name": "oracle-psycho-intuition",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "oracle.psycho-intuition.fr", "custom_domain": true }
  ],
  "build": {
    "command": "node scripts/build-cloudflare-assets.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
